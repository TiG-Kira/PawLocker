*.iml
.gradle
/local.properties
/.idea
.DS_Store
# 注意：不能写成 `/build` —— 那只忽略根目录，
# core/ ui/ androidApp/ windowsApp/ 各自的 build 产物会全部被提交进来
build/
/captures
.externalNativeBuild
.cxx
local.properties
.kotlin

# 应用运行期产物
*.log
/pawlocker-config.json
/dist
*.exe
*.msi
*.apk
*.aab

# 发布签名：密钥库与凭据一律不入库
# 注意 keystore.properties 必须在 .gitignore 之后再创建，顺序反了就会漏提交一次
keystore.properties
*.jks
*.keystore
*.p12
*.pfx

# 会话本地记忆（个人工作日志，不属于工程内容）
# 注意：不要整目录忽略 —— .workbuddy/skills/ 是要跟团队共享的项目级技能
.workbuddy/memory/
.workbuddy/sessions/

# 原生凭据提供程序的构建产物
/credential-provider/build/
*.obj
*.pdb
*.exp

# 链接中间产物（正常情况下会被 /IMPLIB 收进 build/）
/credential-provider/*.lib
/credential-provider/*.exp

# 打包资源目录里的 DLL：由 credential-provider 构建产出，构建时拷入。
# 它是二进制构建产物，不入库 —— 仓库里的源码 + 签名脚本才是唯一来源。
# 保留目录本身（其中的 .gitkeep 会入库），避免首次 clone 时 Gradle 找不到路径。
/windowsApp/resources/windows/*.dll
