<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Miuix 自己负责全部 UI 着色，这里只需要一个不干扰它的基础主题：
      无 ActionBar、透明状态栏，让 Compose 完全接管窗口。

      ⚠️ `windowLayoutInDisplayCutoutMode` 需要 API 27，而 minSdk 是 26。
      放在这里会让 Lint 报 NewApi 错误并**卡住 release 打包**，
      所以刘海屏适配单独放到 values-v27/themes.xml（见该文件）。
    -->
    <style name="Theme.PawLocker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
